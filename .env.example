# Adres backendu PRAWDOWID używany wyłącznie po stronie serwera
# (src/app/api/analyze/route.ts). Dzięki temu przeglądarka nie potrzebuje CORS.
# Produkcja: https://api.prawdowid.org
# Lokalnie: http://localhost:3000
BACKEND_API_URL=http://localhost:3000

# Opcjonalne nadpisanie endpointu wywoływanego przez przeglądarkę.
# Domyślnie /api/analyze (proxy do backendu).
NEXT_PUBLIC_ANALYSIS_API_URL=/api/analyze
